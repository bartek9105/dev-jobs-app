# Copy to .env.local and fill in. Never commit real secrets.
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time — public by definition.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local values come from `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
